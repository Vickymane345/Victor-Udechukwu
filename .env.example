# Copy to .env.local for local dev, and add the same keys in
# Vercel -> your portfolio project -> Settings -> Environment Variables.
#
# All three are OPTIONAL. Without them the Work section still builds itself
# from your public repos and the homepage URL Vercel writes onto each repo.

# github.com/settings/tokens -> fine-grained or classic, PUBLIC repos only.
# Raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# vercel.com/account/tokens -> scope it to your personal account.
# Gives the real production alias (custom domains included) per project.
VERCEL_TOKEN=

# Only if your projects live under a Vercel team, not your personal account.
VERCEL_TEAM_ID=

# Preview images: microlink (default) | thum | github
NEXT_PUBLIC_SCREENSHOT_PROVIDER=microlink
